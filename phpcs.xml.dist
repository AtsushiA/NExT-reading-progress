<?xml version="1.0"?>
<ruleset name="NExT Reading Progress">
	<description>Coding standards for the NExT Reading Progress plugin.</description>

	<!-- 対象ファイル -->
	<file>./next-reading-progress.php</file>
	<file>./includes/</file>
	<file>./src/reading-progress/render.php</file>

	<!-- 対象拡張子（JS/CSSはwp-scripts lint-js/lint-cssで別途チェックする） -->
	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<!-- 除外 -->
	<exclude-pattern>./vendor/*</exclude-pattern>
	<exclude-pattern>./node_modules/*</exclude-pattern>
	<exclude-pattern>./build/*</exclude-pattern>
	<exclude-pattern>./tests/*</exclude-pattern>

	<!-- WordPress Coding Standards -->
	<rule ref="WordPress">
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
	</rule>

	<!--
		render.php はブロックの動的レンダリング用テンプレートで、トップレベルの変数は
		include先スコープのローカル変数（$attributes/$content/$block と同じ扱い）。
		phpcsの静的解析はファイルスコープを"global"とみなすため誤検出するので、
		このファイルに限り PrefixAllGlobals を除外する。
	-->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<exclude-pattern>src/reading-progress/render.php</exclude-pattern>
	</rule>

	<!-- PHP互換性チェック -->
	<rule ref="PHPCompatibilityWP"/>

	<!-- PHP バージョン -->
	<config name="testVersion" value="7.4-"/>

	<!-- テキストドメイン -->
	<config name="text_domain" value="next-reading-progress"/>

	<!-- プレフィックス -->
	<config name="prefixes" value="next_reading_progress,NExT_Reading_Progress"/>
	<config name="minimum_wp_version" value="6.8"/>
</ruleset>
